# Backend
DHIS2_BASE_URL=https://dhis2.example.com
DHIS2_PAT=your_personal_access_token
DHIS2_PROGRAM_ID=AJy1cnAA50U
SQLITE_PATH=/data/iss.db
SYNC_CRON=0 */6 * * *
ADMIN_TOKEN=your_admin_secret_token
DASHBOARD_PUBLIC=true
PORT=8081

# Frontend (build arg)
VITE_API_BASE_URL=https://xxx.com/iss

# Carte sanitaire — population (UIDs des data elements de l'instance, sommés par indicateur)
# Format : indicateur:uid[+uid],indicateur:uid ... ; vide = ratios démographiques désactivés
DHIS2_POPULATION_DX=total:ksBi2JIApqW+oVYNP4fGnTo,moins5:hLcbHlNiRqP,fap:vRIHUMcfSnT,grossesses:IYeo7xNzEWy,accouchements:UQxlKligKNQ
DHIS2_POPULATION_LEVELS=1,2,3,4
# Facteur appliqué à la dernière valeur mensuelle (12 : la valeur saisie chaque mois = population annuelle / 12)
DHIS2_POPULATION_FACTOR=12
# Carte sanitaire — noms des group sets DHIS2 (typologie, sous-type hôpital, public/privé)
DHIS2_TYPOLOGY_GROUPSET=01 TOUTES LES STRUCTURES
DHIS2_HOSPITAL_GROUPSET=07 HÖPITAUX
DHIS2_OWNERSHIP_GROUPSET=02 PUBLIC PRIVEE
